# Copiar este archivo a .env en la raíz y completar localmente.
# Frontend: guardar solo variables públicas en apps/web/.env.local.
# Vite expone las variables VITE_* al navegador: nunca incluir secretos ahí.
# Runtime del Worker: DATABASE_URL pooled; dev:api añade LOCAL_DEVELOPMENT solo en local.
# Drizzle Kit, migraciones y seed: DATABASE_URL_DIRECT directa.
# Producción: configurar DATABASE_URL como secreto del Worker.
# Producción: NEON_AUTH_URL como secreto del Worker; ver apps/api/DEPLOYMENT.md.

DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Opcional en local: autenticar con la rama de desarrollo de Neon Auth en lugar del usuario fijo.
# NEON_AUTH_URL=https://ep-YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# Catalog editors: comma-separated, verified account email addresses.
CATALOG_EDITOR_EMAILS=
