{
  "name": "@relieve/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-api.mjs",
    "build": "tsc --noEmit && wrangler deploy --config wrangler.production.jsonc --dry-run --outdir dist",
    "deploy:preview": "wrangler preview --config wrangler.production.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json"
  },
  "dependencies": {
    "@relieve/database": "*",
    "@relieve/shared": "*",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "saxes": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  }
}
