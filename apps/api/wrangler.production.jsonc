{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relieve-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
