{
  "name": "@relieve/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/check.ts",
    "data:check": "tsx scripts/checkDataset.ts",
    "test": "tsx --test scripts/dataset.test.ts scripts/dto.test.ts ../../apps/api/test/*.test.ts",
    "test:integration": "tsx --test scripts/integration.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@relieve/shared": "*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.12",
    "tsx": "^4.23.15"
  }
}
