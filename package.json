{
  "name": "relieve-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@relieve/web",
    "dev:api": "node scripts/dev-api.mjs",
    "deploy:preview": "npm run deploy:preview --workspace=@relieve/api --",
    "deploy:production": "npm run deploy:production --workspace=@relieve/api --",
    "db:generate": "npm run db:generate --workspace=@relieve/database",
    "db:migrate": "npm run db:migrate --workspace=@relieve/database",
    "db:seed": "npm run db:seed --workspace=@relieve/database",
    "db:check": "npm run db:check --workspace=@relieve/database",
    "build": "npm run build --workspace=@relieve/shared && npm run build --workspace=@relieve/database && npm run build --workspace=@relieve/web && npm run build --workspace=@relieve/api",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces",
    "data:check": "npm run data:check --workspace=@relieve/database",
    "test": "npm run test:config && npm run build --workspace=@relieve/database && npm run test --workspaces --if-present",
    "test:coverage": "c8 npm test",
    "test:config": "node --test scripts/wrangler.test.mjs",
    "test:integration": "npm run build --workspace=@relieve/database && npm run test:integration --workspace=@relieve/database"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "c8": {
    "all": true,
    "include": [
      "apps/api/src/**/*.ts",
      "apps/web/src/**/*.{ts,tsx}",
      "packages/database/src/**/*.ts",
      "packages/shared/src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
